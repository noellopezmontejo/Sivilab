            <div class="card p-4 mb-4">
                <h5 class="fw-bold mb-3">Términos y Condiciones</h5>
                
                <div class="form-check mb-2">
                    <InputCheckbox class="form-check-input" @bind-Value="empresa.AceptaTerminos" id="terminos" />
