@code {
    private EmpresaDto empresa = new();
    private int pasoActual = 1;

    // Modal Sucursal
    private bool mostrarModalSucursal = false;
    private SucursalDto nuevaSucursal = new();

    private async Task HandleSubmit()
    {
        Console.WriteLine($"Creando cuenta para: {empresa.Nombre}");
        var success = await EmpresaService.CrearEmpresa(empresa);
        if (success)
        {
            pasoActual = 2; 
        }
    }

    private void AvanzarPaso3()
    {
        Console.WriteLine("Avanzando al paso 3 (Tipo de empresa)");
        pasoActual = 3;
    }

    private void AvanzarPaso4()
    {
        if (string.IsNullOrWhiteSpace(empresa.TipoEmpresa)) return;
        
        Console.WriteLine($"Tipo de empresa seleccionado: {empresa.TipoEmpresa}");
        pasoActual = 4;
    }

    private void AvanzarPaso5()
    {
        // Simple manual validation for now since we relaxed DTO
        if ((empresa.EsPersonaMoral && string.IsNullOrWhiteSpace(empresa.RFC)) ||
            (!empresa.EsPersonaMoral && string.IsNullOrWhiteSpace(empresa.Curp) && string.IsNullOrWhiteSpace(empresa.PrimerApellido)))
            return;

        Console.WriteLine("Avanzando al paso 5...");
        pasoActual = 5;
    }

    private void GuardarUbicacion()
    {
        if (string.IsNullOrWhiteSpace(empresa.CodigoPostal) || 
            string.IsNullOrWhiteSpace(empresa.Estado) || 
            string.IsNullOrWhiteSpace(empresa.Municipio)) return;

        Console.WriteLine($"Ubicación guardada: {empresa.Calle}, {empresa.Municipio}, {empresa.Estado}");
        // Avanzar al siguiente paso (Acerca de)
        pasoActual = 6; 
    }

    private void GuardarAcercaDe()
    {
         if (string.IsNullOrWhiteSpace(empresa.NumeroEmpleados) || 
             string.IsNullOrWhiteSpace(empresa.DescripcionEmpresa)) return;

         Console.WriteLine($"Datos de empresa guardados. Empleados: {empresa.NumeroEmpleados}");
         // Avanzar al siguiente paso
         pasoActual = 7;
    }

    private void GuardarContacto()
    {
         if (string.IsNullOrWhiteSpace(empresa.ContactoCargo) || 
             string.IsNullOrWhiteSpace(empresa.ContactoApellidos) ||
             string.IsNullOrWhiteSpace(empresa.ContactoTelefono)) return;

         Console.WriteLine($"Contacto guardado: {empresa.ContactoCargo}");
         // Avanzar al siguiente paso (Finish?)
         pasoActual = 8;
    }

    private void FinalizarRegistro()
    {
         if (!empresa.AceptaTerminos || !empresa.AseguraDatosCorrectos || !empresa.AceptaDerechosArco) return;

         Console.WriteLine("Registro finalizado con éxito.");
         pasoActual = 9;
    }

    private void IrACrearOferta()
    {
        Navigation.NavigateTo("/ofertas/nueva");
    }

    private void RetrocederPaso()
    {
        if (pasoActual > 1) pasoActual--;
    }

    private void CerrarModalSucursal()
    {
        mostrarModalSucursal = false;
        nuevaSucursal = new(); // Reset
        if (!empresa.Sucursales.Any()) empresa.TieneSucursales = false; // Reset check if canceled and list empty
    }

    private void AgregarSucursal()
    {
        empresa.Sucursales.Add(nuevaSucursal);
        nuevaSucursal = new(); // Reset for next
        mostrarModalSucursal = false;
        empresa.TieneSucursales = true;
    }
}
