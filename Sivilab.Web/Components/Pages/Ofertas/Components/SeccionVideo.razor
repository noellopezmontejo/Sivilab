@using Sivilab.Web.Components.Models
@using Microsoft.AspNetCore.Components.Forms

<div class="card mb-4" >
    <div class="card-header">
        Video de la oferta de empleo
    </div>
    <div class="card-body">
            <div class="mb-3">
            <label for="videoUrl" class="form-label">Dirección electrónica YouTube</label>
            <InputText id="videoUrl" class="form-control" @bind-Value="Oferta.VideoUrl" placeholder="https://www.youtube.com/tu-videoCV" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public OfertaEmpleoDto Oferta { get; set; } = default!;
}
