@using Sivilab.PortalEmpleo.Models

<style>
    .detalle-oferta {
        flex: 1 1 65%;
        background: var(--text-light, #ffffff);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 12px rgba(35, 91, 78, 0.08);
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        font-family: 'Noto Sans', sans-serif;
        border: 1px solid var(--gray-300, #d1d5db);
    }

    .detalle-oferta h3 {
        font-family: 'Patria', serif;
        font-size: 2rem;
        color: var(--primary-color, #235B4E);
        margin-bottom: 0.5rem;
        font-weight: 700;
        line-height: 1.2;
        position: relative;
        text-shadow: 0 1px 2px rgba(35, 91, 78, 0.1);
        background: linear-gradient(135deg, var(--primary-color, #235B4E), #2d7068);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .detalle-oferta h3::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 80px;
        height: 3px;
        background: linear-gradient(90deg, var(--secondary-color, #BC955C), var(--primary-color, #235B4E));
        border-radius: 2px;
        box-shadow: 0 2px 4px rgba(188, 149, 92, 0.3);
    }

    .empresa-detalle {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        padding: 0.8rem 1.2rem;
        border-radius: 25px;
        border: 1px solid var(--gray-300, #d1d5db);
        box-shadow: 0 2px 8px rgba(35, 91, 78, 0.08);
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .empresa-detalle:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(35, 91, 78, 0.12);
    }

    .icono-empresa {
        background: var(--primary-color, #235B4E);
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        box-shadow: 0 2px 6px rgba(35, 91, 78, 0.3);
    }

    .texto-empresa {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .nombre-empresa {
        font-weight: 700;
        color: var(--text-dark, #235B4E);
        font-size: 1.1rem;
        font-family: 'Patria', serif;
        letter-spacing: 0.2px;
    }

    .ubicacion-empresa {
        font-size: 0.85rem;
        color: var(--gray-500, #6b7280);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .btn-postular {
        background-color: var(--primary-color, #235B4E);
        color: var(--text-light, #ffffff);
        padding: 0.5rem 1.2rem;
        font-size: 0.9rem;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        align-self: flex-start;
        margin-top: 0.5rem;
    }

    .btn-postular:hover {
        background-color: var(--secondary-color, #BC955C);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(35, 91, 78, 0.2);
    }

    .seccion-header {
        background-color: var(--secondary-color, #BC955C);
        color: var(--text-light, #ffffff);
        text-align: center;
        padding: 0.6rem 1rem;
        border-radius: 20px;
        font-size: 1rem;
        font-weight: 600;
        margin: 1.5rem 0 1rem 0;
        font-family: 'Patria', sans-serif;
    }

    .info-contacto {
        background: linear-gradient(135deg, var(--secondary-color, #BC955C), rgba(188, 149, 92, 0.8));
        color: var(--text-light, #ffffff);
        padding: 1rem;
        border-radius: 15px;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        font-size: 0.9rem;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .seccion-dual {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin: 1.5rem 0;
    }

    .columna {
        background: var(--bg-light, #f3f4f6);
        padding: 1rem;
        border-radius: 10px;
        border: 1px solid var(--gray-300, #d1d5db);
    }

    .columna h5 {
        background-color: var(--primary-color, #235B4E);
        color: var(--text-light, #ffffff);
        text-align: center;
        padding: 0.5rem;
        border-radius: 15px;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        font-family: 'Patria', sans-serif;
    }

    .columna ul {
        padding-left: 0;
        margin: 0;
        list-style: none;
    }

    .columna ul li {
        margin-bottom: 0.4rem;
        font-size: 0.9rem;
        line-height: 1.4;
        color: var(--gray-600, #4b5563);
        position: relative;
        padding-left: 1rem;
    }

    .columna ul li::before {
        content: "•";
        color: var(--primary-color, #235B4E);
        font-weight: bold;
        position: absolute;
        left: 0;
    }

    .experiencia-item {
        border-left: 3px solid var(--primary-color, #235B4E);
        padding-left: 1rem;
        margin-bottom: 1.5rem;
        position: relative;
    }

    .experiencia-item::before {
        content: "";
        position: absolute;
        left: -6px;
        top: 0;
        width: 12px;
        height: 12px;
        background-color: var(--primary-color, #235B4E);
        border-radius: 50%;
    }

    .experiencia-item h6 {
        color: var(--primary-color, #235B4E);
        font-weight: 600;
        margin-bottom: 0.3rem;
        font-size: 0.95rem;
    }

    @@media (max-width: 768px) {
        .seccion-dual {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
        .info-grid {
            grid-template-columns: 1fr;
        }
        .detalle-oferta {
            padding: 1.5rem;
        }
        .detalle-oferta h3 {
            font-size: 1.6rem;
        }
        .empresa-detalle {
            flex-direction: column;
            text-align: center;
            gap: 0.4rem;
            padding: 1rem;
        }
        .texto-empresa {
            align-items: center;
        }
    }
</style>

@if (Oferta != null)
{
    <div class="detalle-oferta">
        <p style="color: var(--gray-500); font-size: 0.9rem;">Hoy</p>
        <h3>@Oferta.OfferName</h3>
        
        <div class="empresa-detalle">
            <div class="icono-empresa">
                <i class="fas fa-building"></i>
            </div>
            <div class="texto-empresa">
                <span class="nombre-empresa">@Oferta.Empresa</span>
                <span class="ubicacion-empresa">
                    <i class="fas fa-map-marker-alt"></i>
                    @Oferta.Ubicacion
                </span>
            </div>
        </div>
        
        <button class="btn-postular">Postularme</button>

        <div class="info-contacto">
            <h4>Información del empleo</h4>
            <div class="info-grid">
                <div class="info-item">
                    <i class="fas fa-building" style="width: 16px;"></i>
                    <span>@Oferta.Empresa</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-map-marker-alt" style="width: 16px;"></i>
                    <span>@Oferta.Ubicacion</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-dollar-sign" style="width: 16px;"></i>
                    <span>$@Oferta.Salario.ToString("N0") MXN</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-clock" style="width: 16px;"></i>
                    <span>@Oferta.Horario</span>
                </div>
            </div>
        </div>

        <div class="seccion-dual">
            <div class="columna">
                <h5>Perfil del puesto</h5>
                <p><strong>Categoría:</strong> @Oferta.Categoria</p>
                <p><strong>Subcategoría:</strong> @Oferta.Subcategoria</p>
                <p><strong>Educación mínima:</strong> @Oferta.Educacion</p>
                <p><strong>Contratación:</strong> @Oferta.Contratacion</p>
                <p><strong>Modalidad:</strong> @Oferta.Modalidad</p>
            </div>

            <div class="columna">
                <h5>Habilidades requeridas</h5>
                <ul>
                    @if(Oferta.Habilidades != null) {
                        foreach (var hab in Oferta.Habilidades)
                        {
                            <li>@hab</li>
                        }
                    }
                </ul>
            </div>
        </div>

        <div class="seccion">
            <div class="seccion-header">Descripción del puesto</div>
            <p>@Oferta.Descripcion</p>
        </div>

        <div class="seccion">
            <div class="seccion-header">Funciones principales</div>
            @if(Oferta.Funciones != null) {
                foreach (var funcion in Oferta.Funciones)
                {
                    <div class="experiencia-item">
                        <h6>@funcion</h6>
                    </div>
                }
            }
        </div>

        <div class="seccion-dual">
            <div class="columna">
                <h5>Requisitos</h5>
                <ul>
                    @if(Oferta.Requisitos != null) {
                        foreach (var req in Oferta.Requisitos)
                        {
                            <li>@req</li>
                        }
                    }
                </ul>
            </div>

            <div class="columna">
                <h5>Beneficios</h5>
                <ul>
                    @if(Oferta.Beneficios != null) {
                        foreach (var beneficio in Oferta.Beneficios)
                        {
                            <li>@beneficio</li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
}

