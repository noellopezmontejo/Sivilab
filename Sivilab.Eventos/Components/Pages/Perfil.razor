@code {
    [Parameter]
    public string? CurpInicial { get; set; }

    [SupplyParameterFromForm]
    private EmpleotonModel formulario { get; set; } = new();
    
    private string mensaje = string.Empty;
    private string tipoMensaje = string.Empty;
    private bool correoAccesoReadOnly = false;
    private string mensajeContrasena = string.Empty;
    private bool contrasenasCoinciden = false;

    // Variables para manejo de BD
    private bool cargando = false;
    private bool guardando = false;
    private int? candidatoIdExistente = null;
    private bool esCandidatoExistente = false;
    private bool mostrarBotonLogin = false;

    [Parameter]
    [SupplyParameterFromQuery(Name = "sesion")]
    public string? Sesion { get; set; }

    protected override void OnInitialized()
    {
        // Inicialización si es necesaria
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(CurpInicial))
        {
            formulario.Curp = CurpInicial.ToUpper();
            
            // Si viene con sesión activa, cargar datos del candidato
            if (Sesion == "activa")
            {
                await CargarDatosCandidato();
            }
            else
            {
                // Nuevo registro - solo auto-llenar desde CURP
                AutoLlenarDesdeCurp();
            }
        }
    }

    private async Task CargarDatosCandidato()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            var candidato = await Repository.ObtenerPorCurp(formulario.Curp);
            
            if (candidato != null)
            {
                esCandidatoExistente = true;
                candidatoIdExistente = candidato.CandidatoId;
                CargarDatosDesdeBaseDatos(candidato);
                MostrarMensaje("info", "Datos cargados. Puede actualizarlos si lo desea.");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("danger", $"Error al cargar datos: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task BuscarCandidatoPorCurp()
    {
        if (string.IsNullOrEmpty(formulario.Curp) || formulario.Curp.Length != 18)
            return;

        cargando = true;
        mostrarBotonLogin = false;
        StateHasChanged();

        try
        {
            var candidato = await Repository.ObtenerPorCurp(formulario.Curp);
            
            if (candidato != null)
            {
                esCandidatoExistente = true;
                candidatoIdExistente = candidato.CandidatoId;
                mostrarBotonLogin = true;
                MostrarMensaje("warning", "Esta CURP ya está registrada. Por favor, inicie sesión para actualizar su información.");
            }
            else
            {
                esCandidatoExistente = false;
                mostrarBotonLogin = false;
                AutoLlenarDesdeCurp();
                MostrarMensaje("success", "CURP válida. Complete el formulario para registrarse.");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("danger", $"Error al buscar información: {ex.Message}");
            Console.WriteLine($"Error completo: {ex}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void IrALogin()
    {
        Navigation.NavigateTo($"/updatecurp/{formulario.Curp}");
    }

    private void AutoLlenarDesdeCurp()
    {
        if (formulario.Curp.Length >= 11)
        {
            char sexo = formulario.Curp[10];
            formulario.Genero = sexo == 'H' ? 1 : sexo == 'M' ? 2 : 3;

            try
            {
                int año = int.Parse(formulario.Curp.Substring(4, 2));
                int mes = int.Parse(formulario.Curp.Substring(6, 2));
                int dia = int.Parse(formulario.Curp.Substring(8, 2));
                año += (año > DateTime.Now.Year % 100) ? 1900 : 2000;
                formulario.FechaNacimiento = new DateTime(año, mes, dia);
            }
            catch { }
        }
    }

    private async Task ValidarCurpAsync()
    {
        var patron = @"^[A-Z]{4}[0-9]{6}[HM][A-Z]{5}[0-9A-Z]{2}$";
        if (System.Text.RegularExpressions.Regex.IsMatch(formulario.Curp, patron))
        {
            MostrarMensaje("success", "CURP válida. Buscando información...");
            await Task.Delay(100);
            await BuscarCandidatoPorCurp();
        }
        else
        {
            MostrarMensaje("danger", "CURP no válida. Verifique el formato.");
        }
    }

    private void OnCurpInput(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString() ?? "";
        formulario.Curp = valor.ToUpper();
        
        if (formulario.Curp.Length == 18)
        {
            _ = ValidarCurpAsync();
        }
    }

    private async Task EnviarFormulario()
    {
        guardando = true;
        StateHasChanged();

        try
        {
            var candidato = MapearFormularioACandidato();

            if (esCandidatoExistente && candidatoIdExistente.HasValue)
            {
                // ACTUALIZAR candidato existente
                candidato.CandidatoId = candidatoIdExistente.Value;
                var actualizado = await Repository.ActualizarCandidato(candidato);
                
                if (actualizado)
                {
                    MostrarMensaje("success", "¡Información actualizada exitosamente!");
                    await Task.Delay(2000);
                    var folio = "EMP-2025-" + candidatoIdExistente.Value.ToString("D6");
                    Navigation.NavigateTo($"/verificacion/{folio}?actualizado=true");
                }
                else
                {
                    MostrarMensaje("danger", "No se pudo actualizar la información. Intente nuevamente.");
                }
            }
            else
            {
                // CREAR nuevo candidato
                var nuevoId = await Repository.AgregarCandidato(candidato);
                
                if (nuevoId > 0)
                {
                    MostrarMensaje("success", "¡Registro exitoso!");
                    await Task.Delay(2000);
                    var folio = "EMP-2025-" + nuevoId.ToString("D6");
                    Navigation.NavigateTo($"/verificacion/{folio}");
                }
                else
                {
                    MostrarMensaje("danger", "No se pudo completar el registro. Intente nuevamente.");
                }
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("danger", $"Error al guardar: {ex.Message}");
            Console.WriteLine($"Error completo: {ex}");
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private CandidatoCrp MapearFormularioACandidato()
    {
        var nombrePartes = formulario.NombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        
        return new CandidatoCrp
        {
            // Si es actualización, mantener el ID
            CandidatoId = candidatoIdExistente ?? 0,
            
            // Datos básicos
            Curp = formulario.Curp,
            Nombre = nombrePartes.Length > 0 ? nombrePartes[0] : "",
            Paterno = nombrePartes.Length > 1 ? nombrePartes[1] : "",
            Materno = nombrePartes.Length > 2 ? string.Join(" ", nombrePartes.Skip(2)) : "",
            Genero = formulario.Genero,
            FechaNacimiento = formulario.FechaNacimiento,
            LugarNacimiento = formulario.LugarNacimiento ?? string.Empty,
            
            // Programa Jóvenes
            EsEgresadoJovenes = formulario.EsEgresadoJovenes ?? string.Empty,
            
            // Contacto
            Telefono = formulario.Telefono,
            CorreoElectronico = formulario.CorreoElectronico,
            CorreoAcceso = formulario.CorreoAcceso,
            
            // Dirección
            Estado = formulario.Estado,
            Municipio = formulario.Municipio,
            CodigoPostal = formulario.CodigoPostal,
            Colonia = formulario.Colonia,
            
            // Formación Académica
            NivelEstudios = formulario.NivelEstudios,
            CarreraEspecialidad = formulario.CarreraEspecialidad,
            
            // Experiencia Laboral
            ExperienciaLaboral = formulario.ExperienciaLaboral,
            PuestosTrabajo = formulario.PuestosTrabajo,
            AniosExperiencia = formulario.AniosExperiencia,
            DominioIdioma = formulario.DominioIdioma,
            
            // Aspiraciones
            PuestoDeseado = formulario.PuestoDeseado,
            SalarioPretendido = formulario.SalarioPretendido,
            
            // Datos de acceso
            UsarMismoCorreo = formulario.UsarMismoCorreo,
            Contrasena = formulario.Contrasena,
            ConfirmarContrasena = formulario.ConfirmarContrasena,
            
            // Términos
            AceptaTerminos = formulario.AceptaTerminos,
            AceptaPrivacidad = formulario.AceptaPrivacidad,
            
            // Folio (generado por el repositorio si es nuevo)
            FolioSIISNE = 0
        };
    }

    private void MostrarMensaje(string tipo, string msg)
    {
        tipoMensaje = tipo;
        mensaje = msg;
        StateHasChanged();
    }

    private void CerrarAlerta() => mensaje = string.Empty;

    private string GetAlertClass() => tipoMensaje switch
