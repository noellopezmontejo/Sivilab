<div class="alert alert-info border-0 mb-3">
    <i class="fas fa-upload me-2"></i>
    <strong>Suba sus documentos</strong> para completar su perfil
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h6><i class="fas fa-id-card me-2"></i>Identificación Oficial</h6>
                <button class="btn btn-sm btn-outline-primary mt-2">
                    <i class="fas fa-upload me-2"></i>Subir documento
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h6><i class="fas fa-file-alt me-2"></i>Currículum Vitae</h6>
                <button class="btn btn-sm btn-outline-primary mt-2">
                    <i class="fas fa-upload me-2"></i>Subir documento
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Curp { get; set; } = string.Empty;
}