@page "/buscarcurp/{Curp}"
@using Sivilab.Eventos.Components.Pages.BuscarCandidato
@using Sivilab.Eventos.Services
@using Sivilab.Models.Models
@inject ICandidatoCrpService Repository
@inject IAccesoWebService AccesoWebService
@inject NavigationManager Navigation

<PageTitle>Verificando CURP - EMPLEOTÓN CHIAPAS 2025</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card shadow-lg">
                <div class="card-header bg-gradient text-white text-center py-3" 
                     style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <h3 class="mb-0">
                        <i class="fas fa-user-lock me-2"></i>
                        VERIFICACIÓN DE CURP
                    </h3>
                    <p class="mb-0 mt-2 small opacity-90">EMPLEOTÓN CHIAPAS 2025</p>
                </div>
                <div class="card-body p-4">

                    <!-- Estado: Buscando -->
                    @if (buscando)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
                            <h5 class="text-muted">Verificando su CURP...</h5>
                            <p class="text-muted small">
                                <strong>CURP:</strong> <span class="font-monospace">@Curp</span>
                            </p>
                        </div>
                    }

                    <!-- Información del Candidato -->
                    @if (candidatoEncontrado != null && !buscando)
                    {
                        <div class="card bg-light mb-3">
                            <div class="card-body py-2">
                                <h6 class="card-title text-primary mb-2">
                                    <i class="fas fa-user me-2"></i>Información Registrada
                                </h6>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <small class="text-muted d-block">CURP:</small>
                                        <strong class="font-monospace">@candidatoEncontrado.Curp</strong>
                                    </div>
                                    <div class="col-md-6">
                                        <small class="text-muted d-block">Nombre:</small>
                                        <strong>@candidatoEncontrado.NombreCompleto</strong>
                                    </div>
                                    <div class="col-md-6">
                                        <small class="text-muted d-block">Correo:</small>
                                        <strong>@candidatoEncontrado.CorreoAcceso</strong>
                                    </div>
                                    <div class="col-md-6">
                                        <small class="text-muted d-block">Estado:</small>
                                        @if (tieneAcceso)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i>Verificado
                                            </span>
                                        }
                                        else if (accesoEncontrado != null)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock me-1"></i>Pendiente verificación
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-times me-1"></i>Sin acceso
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Escenario 1: Email Confirmado - Mostrar Login -->
                    @if (candidatoEncontrado != null && tieneAcceso && !buscando && !mostrarVerificacionManual)
                    {
                        <div class="alert alert-success border-0 mb-3">
                            <i class="fas fa-check-circle me-2"></i>
                            <small>Inicie sesión para acceder al sistema</small>
                        </div>
                        
                        <LoginForm Curp="@Curp" Email="@candidatoEncontrado.CorreoAcceso" />

                        <div class="text-center mt-3">
                            <hr class="my-3" />
                            <p class="small text-muted mb-2">¿No puede iniciar sesión?</p>
                            <button type="button" 
                                    class="btn btn-outline-warning btn-sm"
                                    @onclick="IrAVerificacionManual">
                                <i class="fas fa-shield-alt me-2"></i>
                                <small>VERIFICAR EMAIL CON CÓDIGO</small>
                            </button>
                        </div>
                    }

                    <!-- Escenario 2: Email NO Confirmado - Verificar Email -->
                    @if (candidatoEncontrado != null && !tieneAcceso && accesoEncontrado != null && !buscando)
                    {
                        <div class="alert alert-warning border-0 mb-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <small>Debe verificar su correo electrónico</small>
                        </div>
                        
                        <!-- CAMBIO: Pasar si debe enviar código automáticamente -->
                        <VerificarEmail Curp="@Curp" 
                                        Email="@candidatoEncontrado.CorreoAcceso"
                                        EnviarCodigoAutomaticamente="@(!codigoYaEnviado)" />
                    }

                    <!-- Escenario 2b: Verificación Manual -->
                    @if (candidatoEncontrado != null && tieneAcceso && mostrarVerificacionManual && !buscando)
                    {
                        <div class="alert alert-info border-0 mb-3">
                            <i class="fas fa-info-circle me-2"></i>
                            <small>Verificación manual del correo electrónico</small>
                        </div>

                        <VerificarEmail Curp="@Curp" 
                                        Email="@candidatoEncontrado.CorreoAcceso"
                                        EnviarCodigoAutomaticamente="false" />

                        <div class="text-center mt-3">
                            <button type="button" 
                                    class="btn btn-link btn-sm"
                                    @onclick="VolverALogin">
                                <i class="fas fa-arrow-left me-1"></i>
                                <small>VOLVER AL LOGIN</small>
                            </button>
                        </div>
                    }

                    <!-- Escenario 3: Sin Acceso - Registrar -->
                    @if (candidatoEncontrado != null && !tieneAcceso && accesoEncontrado == null && !buscando)
                    {
                        <div class="alert alert-warning border-0 mb-3">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <small>Esta CURP no tiene credenciales de acceso</small>
                        </div>
                        
                        <RegistrarAcceso Candidato="@candidatoEncontrado" 
                                         OnRegistroExitoso="ManejarRegistroExitoso" />
                    }

                    <!-- Botón volver -->
                    @if (!buscando)
                    {
                        <div class="text-center mt-3">
                            <a href="/" class="btn btn-link btn-sm">
                                <i class="fas fa-arrow-left me-1"></i><small>Volver al Inicio</small>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Curp { get; set; } = string.Empty;

    private bool buscando = true;
    private bool tieneAcceso = false;
    private bool mostrarVerificacionManual = false;
    private bool codigoYaEnviado = false; // NUEVO: Controlar si ya se envió el código
    private CandidatoCrp? candidatoEncontrado = null;
    private AccesoWeb? accesoEncontrado = null;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("🔄 BuscarCurp.OnInitializedAsync - Iniciando búsqueda");
        await BuscarCandidato();
    }

    private async Task BuscarCandidato()
    {
        buscando = true;
        StateHasChanged();

        try
        {
            Console.WriteLine($"🔍 Buscando CURP: {Curp}");
            await Task.Delay(500);
            
            candidatoEncontrado = await Repository.ObtenerPorCurp(Curp);

            if (candidatoEncontrado != null)
            {
                Console.WriteLine($"✅ Candidato encontrado: {candidatoEncontrado.NombreCompleto}");
                Console.WriteLine($"📧 Buscando acceso para email: {candidatoEncontrado.CorreoAcceso}");
                
                accesoEncontrado = await AccesoWebService.ObtenerPorEmail(candidatoEncontrado.CorreoAcceso);
                
                if (accesoEncontrado != null)
                {
                    Console.WriteLine($"🔑 Acceso encontrado - IsEmailConfirmed: {accesoEncontrado.IsEmailConfirmed}");
                    tieneAcceso = accesoEncontrado.IsEmailConfirmed;
                    
                    // MARCAR que el código ya fue enviado previamente
                    if (!tieneAcceso)
                    {
                        Console.WriteLine("⚠️ Email NO confirmado - Se mostrará VerificarEmail");
                        codigoYaEnviado = true; // Primera vez se enviará, luego no
                    }
                }
                else
                {
                    Console.WriteLine("❌ No se encontró acceso para este email");
                    tieneAcceso = false;
                }
            }
            else
            {
                Console.WriteLine("❌ CURP no encontrado - Redirigiendo a registro");
                await Task.Delay(2000);
                Navigation.NavigateTo($"/emploton/{Curp}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error en BuscarCandidato: {ex.Message}");
        }
        finally
        {
            buscando = false;
            StateHasChanged();
        }
    }

    private async Task RecargarPagina()
    {
        Console.WriteLine("🔄 RecargarPagina llamado");
        mostrarVerificacionManual = false;
        await BuscarCandidato();
    }

    private async Task ManejarRegistroExitoso()
    {
        Console.WriteLine("✅ Registro exitoso - Recargando");
        codigoYaEnviado = false; // Resetear para nuevo usuario
        await BuscarCandidato();
    }

    private void IrAVerificacionManual()
    {
        Console.WriteLine("👤 Usuario solicitó verificación manual");
        mostrarVerificacionManual = true;
        StateHasChanged();
    }

    private void VolverALogin()
    {
        Console.WriteLine("◀️ Volver al login");
        mostrarVerificacionManual = false;
        StateHasChanged();
    }
}